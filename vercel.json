{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/supabase-config.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "*.mp4",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/supabase-config\\.js$",
      "dest": "/api/supabase-config"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/favicon\\.ico$",
      "dest": "/Logo.jpg"
    },
    {
      "src": "^/(.*)$",
      "dest": "/$1"
    }
  ]
}
